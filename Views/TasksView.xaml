<UserControl x:Class="DoAn.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Deadline" FontSize="26"
                       FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- Bộ lọc -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <ComboBox x:Name="cbFilterSubject" Width="180" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="cbFilterSubject_SelectionChanged">
                    <ComboBoxItem Content="Tất cả môn"/>
                    <ComboBoxItem Content="Nhập môn lập trình"/>
                    <ComboBoxItem Content="Đại số tuyến tính"/>
                </ComboBox>
                <ComboBox x:Name="cbFilterStatus" Width="150" Margin="0,0,8,0" SelectedIndex="0">
                    <ComboBoxItem Content="Mọi trạng thái"/>
                    <ComboBoxItem Content="Chưa làm"/>
                    <ComboBoxItem Content="Đang làm"/>
                    <ComboBoxItem Content="Hoàn thành"/>
                </ComboBox>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="dgTasks" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" RowHeight="42" Background="White"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nhiệm vụ" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Môn" Binding="{Binding Subject}" Width="150"/>
                        <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTemplateColumn Header="Ưu tiên" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{Binding PriorityBrush}">
                                        <TextBlock Text="{Binding Priority}" Foreground="White" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Form -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Thông tin nhiệm vụ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <TextBlock Text="Tiêu đề" Style="{StaticResource FieldLabel}"/>
                <TextBox/>

                <TextBlock Text="Môn học" Style="{StaticResource FieldLabel}"/>
                <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Nhập môn lập trình"/>
                    <ComboBoxItem Content="Đại số tuyến tính"/>
                </ComboBox>

                <TextBlock Text="Deadline" Style="{StaticResource FieldLabel}"/>
                <DatePicker/>

                <TextBlock Text="Mức độ ưu tiên" Style="{StaticResource FieldLabel}"/>
                <ComboBox SelectedIndex="1">
                    <ComboBoxItem Content="Thấp"/>
                    <ComboBoxItem Content="Trung bình"/>
                    <ComboBoxItem Content="Cao"/>
                </ComboBox>

                <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}"/>
                <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Chưa làm"/>
                    <ComboBoxItem Content="Đang làm"/>
                    <ComboBoxItem Content="Hoàn thành"/>
                </ComboBox>

                <UniformGrid Columns="3" Margin="0,6,0,0">
                    <Button Content="Thêm" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"/>
                    <Button Content="Sửa" Style="{StaticResource PrimaryButton}" Margin="2,0"/>
                    <Button Content="Xóa" Style="{StaticResource DangerButton}" Margin="4,0,0,0"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>