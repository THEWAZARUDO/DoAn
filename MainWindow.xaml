<Window x:Class="DoAn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAn"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}">
            <StackPanel>
                <TextBlock Text="📚 Học tập" Foreground="White" FontSize="32"
                           FontWeight="Bold" Margin="20,24,20,24"/>
                <RadioButton x:Name="rbSubjects" Content="📘  Môn học" IsChecked="True" FontSize="20"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="rbTasks" Content="✅  Nhiệm vụ" FontSize="20"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                <RadioButton x:Name="rbSchedule" Content="🗓  Thời khóa biểu" FontSize="20"
                             Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- Nội dung -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="24"/>
    </Grid>
</Window>